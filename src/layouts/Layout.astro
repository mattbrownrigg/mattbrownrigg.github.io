---
// Fonts: self-hosted Latin subsets (no third-party render-blocking request).
// Chakra Petch (geometric display) · Zen Old Mincho (editorial serif body) · Azeret Mono (labels/metadata)
import '@fontsource/chakra-petch/latin-300.css';
import '@fontsource/chakra-petch/latin-400.css';
import '@fontsource/chakra-petch/latin-500.css';
import '@fontsource/chakra-petch/latin-600.css';
import '@fontsource/zen-old-mincho/latin-400.css';
import '@fontsource/zen-old-mincho/latin-500.css';
import '@fontsource/azeret-mono/latin-400.css';
import '@fontsource/azeret-mono/latin-500.css';
import '../styles/global.css';
// Preloaded so the hero name and wordmark paint in their real face sooner.
import chakra300 from '@fontsource/chakra-petch/files/chakra-petch-latin-300-normal.woff2?url';
import chakra500 from '@fontsource/chakra-petch/files/chakra-petch-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Matthew Brownrigg — ML Engineer & NLP Researcher at Johns Hopkins, working on LLM inference-time reasoning.' } = Astro.props;

// Absolute URLs on the canonical host (astro.config `site`), so crawlers
// never land on the bare-domain redirect.
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const siteRoot = new URL('/', site).href;
const ogImage = new URL('/media/matthew_brownrigg.jpg', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter (also feeds Google's thumbnail candidates) -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />

    <!-- Structured data: Person -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Matthew Brownrigg',
        url: siteRoot,
        image: ogImage,
        jobTitle: 'ML Engineer & NLP Researcher',
        affiliation: {
          '@type': 'Organization',
          name: 'Johns Hopkins University',
          url: 'https://www.jhu.edu',
        },
        sameAs: [
          'https://github.com/mattbrownrigg',
          'https://www.linkedin.com/in/matthewbrownrigg/',
          'https://x.com/matt_brownrigg_',
        ],
      })}
    />

    <link rel="preload" href={chakra300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={chakra500} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
